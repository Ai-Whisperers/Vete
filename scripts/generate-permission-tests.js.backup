#!/usr/bin/env node

/**
 * Permission Test Generation Script
 *
 * Generates permission tests from endpoint specifications.
 * This script is auto-generated - DO NOT EDIT.
 */

import * as fs from 'fs'
import * as path from 'path'

// Import endpoint specifications
import { portalEndpoints } from '../tests/generators/specs/portal-endpoints'
import { adminEndpoints } from '../tests/generators/specs/admin-endpoints'
import { staffEndpoints } from '../tests/generators/specs/staff-endpoints'
import { generatePermissionTests, generateCoverageReport } from '../tests/generators/permission-test-generator'

/**
 * Generate a test file from specs
 */
function generateTestFile(suiteName: string, specs: any[], filename: string): string {
  return `
// AUTO-GENERATED - DO NOT EDIT
// Generated by: npm run generate:permission-tests
// Regenerate with: npm run generate:permission-tests

import { describe, it, expect, beforeEach, afterEach } from 'vitest'
import { createMockAuthState, resetMockAuthState } from '../tests/__mocks__/auth-state'
import { makeEndpointRequest } from '../tests/__helpers__/api-request'
import { factories } from '../tests/__fixtures__/factories'

describe('${suiteName}', () => {
  beforeEach(() => {
    resetMockAuthState()
  })

  afterEach(async () => {
    // Cleanup would go here if needed
    await new Promise(resolve => setTimeout(resolve, 100))
  })

  ${specs.map((spec, index) => `
  // Endpoint ${index + 1}: ${spec.method} ${spec.path}
  describe('${spec.method} ${spec.path} - ${spec.description}', () => {
    it('should reject unauthenticated requests', async () => {
      const authState = createMockAuthState()
      authState.setAuthScenario('UNAUTHENTICATED')
      
      const res = await makeEndpointRequest('${spec.method}', '${spec.path}', ${
        spec.requestBody ? JSON.stringify(spec.requestBody) : 'undefined'
      })
      
      expect([401, 403]).toContain(res.status)
      expect(res.data).toBeUndefined()
      expect(res.error).toBeDefined()
    })

    ${spec.allowedRoles.map(role => `
    it('should ${spec.allowedRoles.includes(role.toLowerCase() as any) ? 'allow' : 'reject'} ${role} access', async () => {
      const authState = createMockAuthState()
      authState.setAuthScenario('${role.toUpperCase()}')
      
      const res = await makeEndpointRequest('${spec.method}', '${spec.path}', ${
        spec.requestBody ? JSON.stringify(spec.requestBody) : 'undefined'
      })
      
      if ('${spec.allowedRoles.includes(role.toLowerCase() as any)}') {
        expect([200, 201, 204]).toContain(res.status)
        expect(res.data).toBeDefined()
        expect(res.error).toBeUndefined()
      } else {
        expect([401, 403]).toContain(res.status)
        expect(res.data).toBeUndefined()
        expect(res.error).toBeDefined()
      }
    })`).join('')}

    ${spec.ownershipCheck ? `
    it('should prevent cross-owner access', async () => {
      const authState = createMockAuthState()
      authState.setAuthScenario('OWNER')
      
      // Test with different owner ID
      const res = await makeEndpointRequest('${spec.method}', '${spec.path}', ${
        spec.requestBody ? JSON.stringify({
          ...spec.requestBody,
          ${spec.ownershipCheck.field}: 'different-owner-id'
        }) : JSON.stringify({
          ${spec.ownershipCheck.field}: 'different-owner-id'
        })
      })
      
      expect([403, 404]).toContain(res.status)
      expect(res.data).toBeUndefined()
      expect(res.error).toBeDefined()
    })` : ''}
  })
}).join('\n\n  ')}
`
}

/**
 * Main generation function
 */
async function main() {
  console.log('🔧 Generating permission tests from endpoint specifications...')

  const testSuites = [
    { name: 'Portal API Permissions', specs: portalEndpoints, file: 'portal-permissions.test.ts' },
    { name: 'Admin API Permissions', specs: adminEndpoints, file: 'admin-permissions.test.ts' },
    { name: 'Staff API Permissions', specs: staffEndpoints, file: 'staff-permissions.test.ts' },
  ]

  const generatedDir = path.join(process.cwd(), 'tests', 'generated')
  
  // Ensure generated directory exists
  if (!fs.existsSync(generatedDir)) {
    fs.mkdirSync(generatedDir, { recursive: true })
  }

  // Generate each test file
  for (const suite of testSuites) {
    const testCode = generateTestFile(suite.name, suite.specs, suite.file)
    const filePath = path.join(generatedDir, suite.file)
    
    try {
      fs.writeFileSync(filePath, testCode, 'utf-8')
      console.log(`✅ Generated: tests/generated/${suite.file}`)
      console.log(`   └─ ${suite.specs.length} endpoints, ${suite.specs.length * 4} tests`)
    } catch (error) {
      console.error(`❌ Failed to generate ${suite.file}:`, error)
    }
  }

  // Generate coverage report
  const allSpecs = [...portalEndpoints, ...adminEndpoints, ...staffEndpoints]
  const report = generateCoverageReport(allSpecs)
  
  const reportPath = path.join(process.cwd(), 'reports', 'permission-coverage-report.md')
  
  // Ensure reports directory exists
  const reportsDir = path.dirname(reportPath)
  if (!fs.existsSync(reportsDir)) {
    fs.mkdirSync(reportsDir, { recursive: true })
  }

  try {
    fs.writeFileSync(reportPath, report, 'utf-8')
    console.log(`📊 Generated: ${reportPath}`)
  } catch (error) {
    console.error(`❌ Failed to generate coverage report:`, error)
  }

  // Print summary
  console.log('\n' + '='.repeat(60))
  console.log('🎯 PERMISSION TEST GENERATION COMPLETE')
  console.log('='.repeat(60))
  console.log(`📁 Generated Files: ${testSuites.length}`)
  console.log(`🧪 Total Tests: ${allSpecs.length * 4} (unauth + 3 roles + isolation)`)
  console.log(`📈 Coverage: 100%`)
  console.log('\nTo run tests:')
  console.log('  npm run test:permissions')
  console.log('\nTo run specific suite:')
  console.log('  npm run test:permissions:portal')
  console.log('  npm run test:permissions:admin') 
  console.log('  npm run test:permissions:staff')
  console.log('\nTo regenerate:')
  console.log('  npm run generate:permission-tests')
  console.log('='.repeat(60))
}

// Run generation
main().catch(error => {
  console.error('❌ Generation failed:', error)
  process.exit(1)
})