{
  "image": "mcr.microsoft.com/vscode/devcontainers/base:alpine",
  "mounts": [
    "source=${localWorkspaceFolder}/web,target=/app,type=bind"
  ],
  "containerMounts": [
    "source=/app/node_modules,target=/app/node_modules,type=bind,consistency=cached"
  ],
  "postCreateCommand": [
    "npm",
    "install"
  ],
  "vscode": {
    "extensions": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "prisma.prisma"
    ]
  }
}