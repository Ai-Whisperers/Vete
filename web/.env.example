# =your_value_here
# Vete Platform - Environment Variables
# =your_value_here
# Copy this file to .env.local and fill in your values
# Required variables are marked with [REQUIRED]
# Optional variables have sensible defaults or are feature-specific
# =your_value_here

# =your_value_here
# SUPABASE CONFIGURATION [REQUIRED]
# =your_value_here
# Get these from your Supabase project dashboard: Settings > API

# Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_value_here

# Supabase anonymous key - safe for client-side (RLS protected)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_value_here

# Supabase service role key - SERVER ONLY, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your_value_here

# Database URL (from Supabase Settings > Database)
DATABASE_URL=your_value_here

# =your_value_here
# OPTIONAL CONFIGURATION
# =your_value_here

# App Configuration
NEXT_PUBLIC_APP_URL=your_value_here
NEXT_PUBLIC_APP_NAME=your_value_here

# Development
NODE_ENV=your_value_here