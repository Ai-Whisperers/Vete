# LEALTIS — Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# ==============================================================================
# SUPABASE [REQUIRED]
# Project: Veterinary (shared) — https://supabase.com/dashboard/project/okddppczckbjdotrxiev
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://okddppczckbjdotrxiev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9rZGRwcGN6Y2tiamRvdHJ4aWV2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjU5MTgzNjgsImV4cCI6MjA4MTQ5NDM2OH0.ZaGuchvSsLLH5KSqSdOZO_2Cdaoa9zLExyIL37XS5jE

# ⚠ KEEP SECRET — never expose this in client-side code
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==============================================================================
# APPLICATION [REQUIRED]
# ==============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://lealtis.com

# ==============================================================================
# EMAIL — RESEND [REQUIRED for contact form notifications]
# Sign up at: https://resend.com — free tier: 3,000 emails/month
# ==============================================================================

RESEND_API_KEY=your_resend_api_key_here

# The verified sending domain you configure in Resend (e.g. info@lealtis.com)
RESEND_FROM_EMAIL=info@lealtis.com

# Where new lead notifications are sent (team inbox)
TEAM_NOTIFICATION_EMAIL=your_team_email@example.com

# ==============================================================================
# CALENDLY [OPTIONAL — for booking widget on /contacto]
# Create a free Calendly account and paste your event URL below
# ==============================================================================

NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/consultation

# ==============================================================================
# ANALYTICS [OPTIONAL]
# ==============================================================================

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=