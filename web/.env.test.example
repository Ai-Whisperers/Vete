# =============================================================================
# Test Environment Configuration
# =============================================================================
# This file is used by Vitest for running tests
# Copy this file to .env.test and fill in your actual values
# WARNING: Never commit real credentials to git
# =============================================================================

# Test-specific settings
NODE_ENV=test
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Disable external services during tests
ENABLE_WHATSAPP=false
EMAIL_PROVIDER=mock
MONITORING_ENABLED=false

# Faster timeouts for tests
DB_TIMEOUT=5000
DB_CONNECT_TIMEOUT=5

# Mock cron secret for testing
CRON_SECRET=test-cron-secret-12345

# Disable rate limiting in tests
RATE_LIMIT_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
